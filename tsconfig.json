{
  "compilerOptions": {
    "isolatedModules": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    // Zero violations when enabled on 2026-08-20, so these cost nothing today
    // and fail the build the first time someone writes a switch case that
    // falls through or a branch that forgets to return.
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    // Turned on after clearing 68 violations. It is the flag that would have
    // caught reportTurnStats shipping dead in 2.18.1 — the helper was written,
    // never called, and tsc stayed silent for a whole release.
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "noEmitOnError": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
