{
  "url": "https://api.openai.com/v1/responses",
  "method": "POST",
  "headers": {
    "content-type": "application/json"
  },
  "body": {
    "model": "gpt-5.6-luna",
    "instructions": "You are a test harness. Use the read_file tool when asked to read a file. Reply in one short line.",
    "input": [
      {
        "type": "message",
        "role": "user",
        "content": "Use read_file to read notes.txt, then reply with the code word only."
      }
    ],
    "tools": [
      {
        "type": "function",
        "name": "read_file",
        "description": "Read the contents of a file. Use this to examine existing files.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Path to the file relative to project root"
            }
          },
          "required": [
            "path"
          ]
        },
        "strict": false
      }
    ],
    "tool_choice": "auto",
    "parallel_tool_calls": true,
    "store": false,
    "include": [
      "reasoning.encrypted_content"
    ],
    "max_output_tokens": 2048,
    "stream": true,
    "stream_options": {
      "include_obfuscation": false
    }
  }
}
